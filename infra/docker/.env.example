# Copy to infra/docker/.env, then start with
#   docker compose --env-file infra/docker/.env --profile app up -d --build
# Every variable is described in docs/infrastructure.md#environment-configuration.

# --- Secrets: generate each once and keep them. Set the passwords before the first start. ---
# openssl rand -base64 32 — seals two-factor and storage secrets; changing it later makes them unreadable.
ENCRYPTION_MASTER_KEY=
# openssl rand -hex 32 — signs unsubscribe links.
EMAIL_LINK_SECRET=
# openssl rand -hex 24 each. Letters and digits only: they go into connection URLs.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
STORAGE_SECRET_KEY=

# --- Addresses. These suit one machine; on a server, use your own hosts (see the guide). ---
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
S3_BROWSER_ENDPOINT=http://localhost:9000
S3_PUBLIC_BUCKET_BASE_URL=http://localhost:9000/nl-public
# SESSION_COOKIE_DOMAIN=.example.com
# The hosts Caddy serves with the `proxy` profile.
# APP_HOST=work.example.com
# API_HOST=api.example.com
# STORAGE_HOST=storage.example.com
# false: nothing sits in front of the API. 1 behind the bundled Caddy or any one proxy.
TRUST_PROXY=false

S3_REGION=auto
S3_PRIVATE_BUCKET=nl-private
S3_PUBLIC_BUCKET=nl-public

# --- Mail. Mailpit catches everything at http://localhost:8025 until a real server is set. ---
EMAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
EMAIL_FROM="Nothing Left <noreply@localhost>"
# SUPPORT_EMAIL=help@example.com
# Where email logos load from: email/logo-light.png and email/logo-dark.png under it.
# ASSET_BASE_URL=

# --- Optional ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# FREE_SEAT_LIMIT=20
# FREE_STORAGE_BYTES=5368709120
POSTHOG_ANALYTICS_ENABLED=false
POSTHOG_ERRORS_ENABLED=false
