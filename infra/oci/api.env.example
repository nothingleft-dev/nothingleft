NODE_ENV=production
HOST=127.0.0.1
LOG_LEVEL=info
LOG_TARGETS=json,posthog
APP_BASE_URL=https://work.nothingleft.dev
API_BASE_URL=https://api.nothingleft.dev
FILES_BASE_URL=https://files.nothingleft.dev
SESSION_COOKIE_DOMAIN=.nothingleft.dev
TRUST_PROXY=127.0.0.1/32,::1/128
S3_REGION=auto
BYO_ALLOW_ANY_ENDPOINT=false
EMAIL_FROM="Nothing Left <noreply@notifications.nothingleft.dev>"
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_ANALYTICS_ENABLED=false
POSTHOG_ERRORS_ENABLED=false
POSTHOG_SAMPLE_RATE=1
SUPPORT_EMAIL=admin@nothingleft.dev

# GitHub Secrets supply these under API_<original name>.
DATABASE_URL=
DATABASE_URL_POOLED=
REDIS_URL=
EMAIL_LINK_SECRET=
ENCRYPTION_MASTER_KEY=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# GitHub Variables supply the deployment-specific storage locations.
S3_ENDPOINT=
S3_PRIVATE_BUCKET=
S3_PUBLIC_BUCKET=
S3_PUBLIC_BUCKET_BASE_URL=

# Optional: the git integration's GitHub App. Set all six or none; without them GitHub connects
# in manual mode. GitHub Variables: API_GITHUB_APP_ID, API_GITHUB_APP_SLUG, API_GITHUB_APP_CLIENT_ID.
# GitHub Secrets: API_GITHUB_APP_CLIENT_SECRET, API_GITHUB_APP_WEBHOOK_SECRET, and
# API_GITHUB_APP_PRIVATE_KEY (the .pem on one line, each line break written as \n).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
