# Copy to apps/web/.env. Next inlines NEXT_PUBLIC_* at build time.
# Match API_BASE_URL in apps/api/.env.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Optional Google Analytics measurement ID.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXX

# Development and tests only, with BYO_ALLOW_ANY_ENDPOINT=true on the API: the storage wizard
# offers a typed endpoint, for a local bucket such as the Docker environment's RustFS.
# NEXT_PUBLIC_BYO_ALLOW_ANY_ENDPOINT=true
