---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@styles/global.css';
import inter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import inter600 from '@fontsource/inter/files/inter-latin-600-normal.woff2?url';
import { PUBLIC_GA_MEASUREMENT_ID } from 'astro:env/client';
import CookieNotice from '@components/analytics/CookieNotice.astro';
import GoogleAnalytics from '@components/analytics/GoogleAnalytics.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { OG_IMAGE, pageMeta } from '@lib/page-meta';
import { markdownPath } from '@lib/markdown-source';
import { SITE_NAME } from '@lib/site';

interface Props {
  /** The metadata route, when it is not the requested URL: the 404 page answers for any missing path. */
  metaPath?: string;
}

const { path, schema, jsonLd, ogImage, ogImageAlt } = pageMeta(Astro.props.metaPath ?? Astro.url.pathname);
const { title, description, noindex } = schema;
const canonical = new URL(path, Astro.site).href;
const markdown = markdownPath(path);
const ogImageUrl = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="describedby" href="/llms.txt" type="text/plain" />
    {markdown && <link rel="alternate" href={markdown} type="text/markdown" title="Markdown" />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter600} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Only the site's own scripts count: a host-injected or third-party tag that fails to load must
      // not switch working components to their static layout.
      addEventListener(
        'error',
        event => {
          const script = event.target;
          if (script instanceof HTMLScriptElement && script.src && new URL(script.src).origin === location.origin) {
            document.documentElement.classList.remove('js');
          }
        },
        true,
      );
    </script>
    <script type="application/ld+json" set:html={jsonLd} />
    {PUBLIC_GA_MEASUREMENT_ID && <GoogleAnalytics id={PUBLIC_GA_MEASUREMENT_ID} />}
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {PUBLIC_GA_MEASUREMENT_ID && <CookieNotice />}
    <script>
      import '@scripts/site';
    </script>
  </body>
</html>
