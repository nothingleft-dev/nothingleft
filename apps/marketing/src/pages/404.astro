---
import PageHero from '@components/PageHero.astro';
import Base from '@layouts/Base.astro';
---

<Base metaPath="/404">
  <PageHero
    eyebrow="404"
    title="This page does not exist."
    lede="The link may be old or mistyped. Start again from the home page, or look in the docs."
  >
    <a class="btn" href="/">
      Go to the home page
      <span class="arr" aria-hidden="true">
        →
      </span>
    </a>
    <a class="link text-sm" href="/docs">
      Browse the docs
      <span class="arr" aria-hidden="true">
        →
      </span>
    </a>
    <a class="link text-sm" href="/support">
      Get support
      <span class="arr" aria-hidden="true">
        →
      </span>
    </a>
  </PageHero>
</Base>
