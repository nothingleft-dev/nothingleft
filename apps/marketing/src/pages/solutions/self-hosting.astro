---
import CallToAction from '@components/CallToAction.astro';
import Faq from '@components/Faq.astro';
import PageHero from '@components/PageHero.astro';
import Architecture from '@components/solutions/self-hosting/Architecture.astro';
import Configuration from '@components/solutions/self-hosting/Configuration.astro';
import Health from '@components/solutions/self-hosting/Health.astro';
import Limits from '@components/solutions/self-hosting/Limits.astro';
import OwnBucket from '@components/solutions/self-hosting/OwnBucket.astro';
import Responsibilities from '@components/solutions/self-hosting/Responsibilities.astro';
import Base from '@layouts/Base.astro';
import { COMPOSE_GUIDE_PATH, SELF_HOSTING_FAQ } from '@lib/solutions/self-hosting';
import { GITHUB_URL, LICENSE_URL, SIGN_UP_URL } from '@lib/site';
---

<Base>
  <PageHero
    eyebrow="Self-hosting"
    title="Run the tracker and its agent interface on your infrastructure."
    lede="Nothing Left is open source under AGPL-3.0. A self-hosted install runs the same build as the hosted service: the web app, one API process that also serves MCP, PostgreSQL, Redis and S3-compatible storage."
  >
    <a class="btn" href={GITHUB_URL}>
      View the source on GitHub
      <span class="arr" aria-hidden="true">
        ↗
      </span>
    </a>
    <a class="link text-sm" href={LICENSE_URL}>
      AGPL-3.0 licence
      <span class="arr ext" aria-hidden="true">
        ↗
      </span>
    </a>
    <a class="link text-sm" href={COMPOSE_GUIDE_PATH}>
      Install guide
      <span class="arr" aria-hidden="true">
        →
      </span>
    </a>
    <p slot="note" class="mt-5 text-xs text-fg-3">
      No reduced community edition: plans are limit presets, not feature gates.
    </p>
  </PageHero>
  <Architecture />
  <Configuration />
  <Limits />
  <OwnBucket />
  <Health />
  <Responsibilities />
  <Faq
    entries={SELF_HOSTING_FAQ}
    title="Questions before you run it yourself."
    intro="Licence, data location, where to install it and who can sign up."
    signup={false}
  />
  <CallToAction
    title="Read the code before you run it."
    body="The source, the licence and the install guides are public. Try it on your own machine first, or join the hosted beta, which runs the same build."
  >
    <a class="btn" href={GITHUB_URL}>
      View the source on GitHub
      <span class="arr" aria-hidden="true">
        ↗
      </span>
    </a>
    <a class="link text-sm" href={COMPOSE_GUIDE_PATH}>
      Install guide
      <span class="arr" aria-hidden="true">
        →
      </span>
    </a>
    <a class="link text-sm" href={SIGN_UP_URL}>
      Join the beta
      <span class="arr" aria-hidden="true">
        →
      </span>
    </a>
  </CallToAction>
</Base>
