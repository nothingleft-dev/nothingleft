---
import Brand from '@components/Brand.astro';
import { normalizePath } from '@data/sitemap-config.mjs';
import { GITHUB_URL, LICENSE_URL } from '@lib/site';

interface FooterLink {
  href: string;
  label: string;
  external?: boolean;
}

const COLUMNS: { title: string; links: FooterLink[] }[] = [
  {
    title: 'Product',
    links: [
      { href: '/features/issue-tracking', label: 'Issues' },
      { href: '/features/sprints-kanban-boards', label: 'Sprints and boards' },
      { href: '/features/search-saved-views', label: 'Search and views' },
      { href: '/features/time-tracking', label: 'Time tracking' },
      { href: '/features/project-reports', label: 'Reports' },
      { href: '/features/project-knowledge-base', label: 'Knowledge base' },
      { href: '/features/mcp-ai-agents', label: 'MCP and agents' },
    ],
  },
  {
    title: 'Solutions',
    links: [
      { href: '/solutions/engineering-teams', label: 'Engineering teams' },
      { href: '/solutions/product-teams', label: 'Product teams' },
      { href: '/solutions/startups', label: 'Startups' },
      { href: '/solutions/self-hosting', label: 'Self-hosting' },
    ],
  },
  {
    title: 'Compare',
    links: [
      { href: '/compare/jira-alternative', label: 'Jira alternative' },
      { href: '/compare/linear-alternative', label: 'Linear alternative' },
      { href: '/compare/youtrack-alternative', label: 'YouTrack alternative' },
      { href: '/compare/clickup-alternative', label: 'ClickUp alternative' },
      { href: '/compare/asana-alternative', label: 'Asana alternative' },
      { href: '/compare/notion-projects-alternative', label: 'Notion alternative' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { href: '/pricing', label: 'Pricing' },
      { href: '/docs', label: 'Docs' },
      { href: '/support', label: 'Support' },
      { href: GITHUB_URL, label: 'GitHub', external: true },
      { href: LICENSE_URL, label: 'Licence', external: true },
      { href: '/terms', label: 'Terms' },
      { href: '/privacy', label: 'Privacy' },
    ],
  },
];
const path = normalizePath(Astro.url.pathname);
---

<footer class="border-t border-line">
  <div class="wrap py-12 md:py-14 flex flex-col lg:flex-row lg:justify-between gap-x-16 gap-y-10">
    <div class="lg:max-w-[280px]">
      <a href="/" class="inline-flex items-center gap-2" aria-label="Nothing Left home">
        <Brand size={22} />
        <span class="text-[18px] leading-none font-semibold tracking-[-0.02em]" aria-hidden="true">
          nothing left<span class="period">.</span>
        </span>
      </a>
      <p class="mt-3 text-sm text-fg-2 max-w-[30ch]">Project tracking for people and AI agents.</p>
      <p class="mt-6 text-xs text-fg-3">© 2026 Nothing Left</p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-[repeat(4,auto)] gap-x-8 lg:gap-x-12 xl:gap-x-20 gap-y-10 lg:whitespace-nowrap">
      {COLUMNS.map(column => (
        <nav aria-label={column.title}>
          <p class="footer-title">{column.title}</p>
          <ul class="mt-4 flex flex-col items-start gap-2.5 text-sm">
            {column.links.map(link => (
              <li>
                <a class="nav-link" href={link.href} aria-current={link.href === path ? 'page' : undefined}>
                  {link.label}
                  {link.external && (
                    <span class="arr ext" aria-hidden="true">
                      ↗
                    </span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
  </div>
</footer>

<style>
  .footer-title {
    font-size: 12px;
    line-height: 16px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
</style>
