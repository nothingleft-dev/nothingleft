---
import Brand from '@components/Brand.astro';
import { GITHUB_URL, LICENSE_URL } from '@lib/site';

const COLUMNS = [
  [
    { href: '/features/issue-tracking', label: 'Issues' },
    { href: '/features/sprints-kanban-boards', label: 'Sprints and boards' },
    { href: '/features/search-saved-views', label: 'Search and reports' },
    { href: '/features/project-knowledge-base', label: 'Knowledge base' },
    { href: '/features/mcp-ai-agents', label: 'MCP and agents' },
  ],
  [
    { href: '/solutions/engineering-teams', label: 'Engineering teams' },
    { href: '/solutions/product-teams', label: 'Product teams' },
    { href: '/solutions/startups', label: 'Startups' },
    { href: '/solutions/self-hosting', label: 'Self-hosting' },
  ],
];
---

<footer class="border-t border-line">
  <div class="wrap py-10 md:py-12 flex flex-col md:flex-row md:items-start justify-between gap-8">
    <div>
      <div class="flex items-center gap-2">
        <Brand size={18} />
        <span class="text-sm font-medium">Nothing Left</span>
      </div>
      <p class="mt-3 text-sm text-fg-2">Project tracking for people and AI agents.</p>
      <p class="mt-6 text-xs text-fg-3">© 2026 Nothing Left</p>
    </div>
    <nav aria-label="Footer" class="grid grid-cols-2 sm:grid-cols-3 gap-x-12 gap-y-2 text-sm">
      {COLUMNS.map(links => (
        <div class="flex flex-col items-start gap-2">
          {links.map(link => (
            <a class="nav-link" href={link.href}>
              {link.label}
            </a>
          ))}
        </div>
      ))}
      <div class="flex flex-col items-start gap-2 col-span-2 sm:col-span-1">
        <a class="nav-link" href="/pricing">
          Pricing
        </a>
        <a class="nav-link" href="/docs">
          Docs
        </a>
        <a class="nav-link" href="/support">
          Support
        </a>
        <a class="nav-link" href={GITHUB_URL}>
          GitHub
          <span class="arr ext" aria-hidden="true">
            ↗
          </span>
        </a>
        <a class="nav-link" href={LICENSE_URL}>
          Licence
          <span class="arr ext" aria-hidden="true">
            ↗
          </span>
        </a>
      </div>
    </nav>
  </div>
</footer>
