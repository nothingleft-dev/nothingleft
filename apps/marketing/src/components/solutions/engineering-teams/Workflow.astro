  }
  .et-standup {
    display: grid;
    grid-template-columns: 140px 1fr;
    row-gap: 6px;
    column-gap: 12px;
    font-size: 13.5px;
    line-height: 20px;
  }
  .et-standup dt {
    color: var(--text-secondary);
  }
  .et-standup dd {
    min-width: 0;
  }
  @media (max-width: 640px) {
    .et-standup {
      grid-template-columns: 1fr;
      row-gap: 0;
    }
    .et-standup dd + dt {
      margin-top: 8px;
    }
  }
  .et-agent-foot {
    padding: 12px 16px 14px;
    font-size: 12.5px;
    line-height: 18px;
    color: var(--text-secondary);
  }
</style>
