---
import { STANDUP_PROMPT, STORY, WORKFLOW_STEPS } from '@lib/solutions/engineering-teams';

const BAR_WIDTHS = [40, 34, 28, 22, 16, 10];
const total = WORKFLOW_STEPS.length;
const pointsText = (points: number | null) =>
  points === null ? 'Not estimated' : `${points} ${points === 1 ? 'point' : 'points'}`;
const priorityLetter = STORY.priority.charAt(0);
const lead = STORY.reporter;
const dev = STORY.developer;
const reproduction = STORY.develop.comment.text.split(/(@\w+|ACME-\d+)/);
---

<section id="et-workflow" class="border-t border-line bg-app" aria-labelledby="et-workflow-title">
  <div class="wrap py-16 md:py-24">
    <div class="max-w-[680px]">
      <h2 id="et-workflow-title" class="h2">
        One issue the developer, lead and agent can all follow.
      </h2>
      <p class="prose mt-5">
        <code>ACME-12</code> from the first report to the morning standup. Every step below changes the same issue, and
        its history records who changed what. Pick a step to see the screen at that point.
      </p>
    </div>

    <div class="mt-10 md:mt-14 grid lg:grid-cols-12 gap-8 lg:gap-12">
      <div class="lg:col-span-4" role="group" aria-label="ACME-12, step by step" data-et-steps>
        {WORKFLOW_STEPS.map((step, index) => (
          <button
            type="button"
            class="wf-step"
            data-et-step={step.id}
            data-et-title={step.title}
            data-last={index === total - 1 ? '' : undefined}
            aria-pressed={index === 0 ? 'true' : 'false'}
            aria-controls="et-panel"
          >
            <span class="bar" style={`width:${BAR_WIDTHS[index]}px`} />
            <span>
              <b>
                <span class="sr-only">{`Step ${index + 1}: `}</span>
                {step.title}
              </b>
              <span class="et-who">{step.who}</span>
              <span>{step.body}</span>
            </span>
          </button>
        ))}
      </div>

      <div class="lg:col-span-8">
        <div class="wf-panel" id="et-panel">
          <div data-view="report" class="on">
            <p class="et-cap">
              <span class="et-n">1 / {total}</span>
              {lead.name} files it · {STORY.report.when}
            </p>
            <div class="pane-bar">
              <span class="mono text-xs">ACME</span>
              <span class="sep">/</span>
              <span>Issues</span>
              <span class="sep">/</span>
              <span class="mono text-xs text-fg">{STORY.key}</span>
            </div>
            <div class="wf-body">
              <div class="flex items-center gap-2 text-xs text-fg-2">
                <span class="badge l-bug" aria-hidden="true">
                  B
                </span>
                {STORY.type}
                <span class:list={['badge ml-2', `l-${STORY.priority.toLowerCase()}`]} aria-hidden="true">
                  {priorityLetter}
                </span>
                {STORY.priority}
              </div>
              <h3 class="wf-title">{STORY.title}</h3>
              <div class="wf-md">
                <p>
                  <strong class="text-fg font-medium">Steps.</strong> Open an invitation link that is older than seven
                  days.
                </p>
                <p>
                  <strong class="text-fg font-medium">Expected.</strong> A message that the link has expired and a way
                  to request a new one.
                </p>
                <p>
                  <strong class="text-fg font-medium">Actual.</strong> A blank page.
                </p>
              </div>
              <dl class="fields">
                <dt>Reporter</dt>
                <dd>
                  <span class="av" aria-hidden="true">
                    {lead.initials}
                  </span>
                  {lead.name}
                </dd>
                <dt>Assignee</dt>
                <dd class="empty">Unassigned</dd>
                <dt>Status</dt>
                <dd>
                  <i class="dot"></i>
                  {STORY.report.status}
                </dd>
                <dt>Sprint</dt>
                <dd class="empty">{STORY.report.sprint ?? 'Unscheduled'}</dd>
                <dt>Story points</dt>
                <dd class="empty">{STORY.report.points ?? 'Not estimated'}</dd>
              </dl>
            </div>
            <div class="activity">
              <p>
                {lead.name} created {STORY.key}
                <span class="t">{STORY.report.day}</span>
              </p>
            </div>
          </div>

          <div data-view="triage">
            <p class="et-cap">
              <span class="et-n">2 / {total}</span>
              {lead.name}, lead, triages · {STORY.triage.when}
            </p>
            <div class="pane-bar">
              <span class="text-fg">Acme</span>
              <span class="sep">/</span>
              <span class="mono text-xs">ACME</span>
              <span class="sep">/</span>
              <span>Issues</span>
            </div>
            <p class="querybar">
              <span class="q">{STORY.triage.query}</span>
              <span class="count">{STORY.triage.rows.length} issues</span>
            </p>
            <ul aria-label="Unassigned open bugs">
              {STORY.triage.rows.map(row => (
                <li class:list={['row', { sel: row.key === STORY.key }]}>
                  <span class="key">{row.key}</span>
                  <span class="title">{row.title}</span>
                  <span class:list={['badge pri', `l-${row.priority.toLowerCase()}`]}>
                    <span aria-hidden="true">{row.priority.charAt(0)}</span>
                    <span class="sr-only">{row.priority}</span>
                  </span>
                  <span class="meta">
                    <span class="who none">Unassigned</span>
                    <span class="spent">—</span>
                    <span class="status">
                      <i class="dot"></i>
                      {row.status}
                    </span>
                  </span>
                </li>
              ))}
            </ul>
            <div class="wf-body et-note">
              <p>
                <kbd>/</kbd> focuses the bar, <kbd>Tab</kbd> completes the first suggestion and <kbd>↵</kbd> runs it.
                Save the query as a view and it becomes a tab above the list, with its count.
              </p>
            </div>
          </div>

          <div data-view="plan">
            <p class="et-cap">
              <span class="et-n">3 / {total}</span>
              {lead.name}, lead, plans it · {STORY.plan.when}
            </p>
            <div class="pane-bar">
              <span class="mono text-xs">ACME</span>
              <span class="sep">/</span>
              <span class="text-fg">Backlog</span>
            </div>
            <div class="et-bl">
              <p class="et-bl-head">
                <span class="text-fg font-medium">{STORY.sprint}</span>
                <span class="et-pill">Planned</span>
                <span class="et-bl-meta">
                  {STORY.sprintGoal} · {STORY.plan.issues} issues, {STORY.plan.points} points · ends {STORY.sprintEnds}
                </span>
              </p>
              <ul aria-label={STORY.sprint}>
                {STORY.plan.shown.map(row => (
                  <li class:list={['et-bl-row', { 'et-dropped': row.key === STORY.key }]}>
                    <span class="et-grip" aria-hidden="true"></span>
                    <span class="key">{row.key}</span>
                    <span class="et-bl-title">{row.title}</span>
                    <span class="et-pts">{pointsText(row.points)}</span>
                  </li>
                ))}
              </ul>
              <p class="et-bl-more">{STORY.plan.more} more issues</p>
            </div>
            <div class="et-bl">
              <p class="et-bl-head">
                <span class="text-fg font-medium">Backlog</span>
                <span class="et-bl-meta">Issues in no sprint</span>
              </p>
              <ul aria-label="Backlog">
                {STORY.plan.backlog.map(row => (
                  <li class="et-bl-row">
                    <span class="et-grip" aria-hidden="true"></span>
                    <span class="key">{row.key}</span>
                    <span class="et-bl-title">{row.title}</span>
                    <span class:list={['et-pts', { 'et-none': row.points === null }]}>{pointsText(row.points)}</span>
                  </li>
                ))}
              </ul>
              <p class="et-bl-more">{STORY.plan.backlogMore} more issues</p>
            </div>
            <div class="wf-body et-tight">
              <dl class="fields">
                <dt>Assignee</dt>
                <dd>
                  <span class="field flash">
                    <span class="av" aria-hidden="true">
                      {dev.initials}
                    </span>{' '}
                    {dev.name}
                  </span>
                </dd>
                <dt>Estimation</dt>
                <dd class="mono text-xs">{STORY.estimate}</dd>
                <dt>Due date</dt>
                <dd>{STORY.due}</dd>
              </dl>
            </div>
            <div class="activity">
              <p>
                {STORY.plan.moved}
                <span class="t">{STORY.plan.day}</span>
              </p>
              <p>
                {STORY.plan.assigned}
                <span class="t">{STORY.plan.day}</span>
              </p>
            </div>
          </div>

          <div data-view="develop">
            <p class="et-cap">
              <span class="et-n">4 / {total}</span>
              {dev.name}, developer, picks it up · {STORY.develop.days}
            </p>
            <div class="pane-bar">
              <span class="mono text-xs">ACME</span>
              <span class="sep">/</span>
              <span>Issues</span>
              <span class="sep">/</span>
              <span class="mono text-xs text-fg">{STORY.key}</span>
            </div>
            <div class="wf-body">
              <div class="flex items-center gap-2 text-xs text-fg-2">
                <span class="badge l-bug" aria-hidden="true">
                  B
                </span>
                {STORY.type}
                <span class:list={['badge ml-2', `l-${STORY.priority.toLowerCase()}`]} aria-hidden="true">
                  {priorityLetter}
                </span>
                {STORY.priority}
              </div>
              <h3 class="wf-title">{STORY.title}</h3>
              <div class="ref">
                <p class="lbl">
                  Depends on <span class="mono">1</span>
                </p>
                <p class="flex items-center gap-2 min-w-0">
                  <span class="key">{STORY.develop.dependency.key}</span>
                  <span class="et-ellipsis">{STORY.develop.dependency.title}</span>
                </p>
              </div>
              <div class="comment">
                <div class="by">
                  <span class="av" aria-hidden="true">
                    {STORY.develop.comment.by.initials}
                  </span>
                  {STORY.develop.comment.by.name}
                  <span class="text-fg-3">{STORY.develop.comment.when}</span>
                </div>
                {reproduction.map(part =>
                  part.startsWith('@') ? (
                    <code class="et-mention">{part}</code>
                  ) : /^ACME-\d+$/.test(part) ? (
                    <span class="key">{part}</span>
                  ) : (
                    part
                  ),
                )}
              </div>
              <dl class="fields">
                <dt>Status</dt>
                <dd>
                  <span class="field flash">
                    <i class="dot started"></i> {STORY.develop.status}
                  </span>
                </dd>
                <dt>Spent time</dt>
                <dd class="et-spent">
                  <span class="mono text-xs">
                    {STORY.develop.spent} <span class="text-fg-2 font-sans">of {STORY.estimate}</span>
                  </span>
                  <span class="et-meter" aria-hidden="true">
                    <span style={`width:${STORY.develop.spentShare}%`}></span>
                  </span>
                </dd>
              </dl>
            </div>
            <div class="activity">
              {STORY.develop.activity.map(entry => (
                <p>
                  {entry.text}
                  <span class="t">{entry.day}</span>
                </p>
              ))}
            </div>
          </div>

          <div data-view="board">
            <p class="et-cap">
              <span class="et-n">5 / {total}</span>
              {dev.name} moves the card · {STORY.board.when}
            </p>
            <div class="pane-bar">
              <span class="mono text-xs">ACME</span>
              <span class="sep">/</span>
              <span>Board</span>
              <span class="sep">/</span>
              <span class="text-fg">{STORY.sprint}</span>
            </div>
            <div class="et-board-head">
              <h3 class="text-fg font-medium">{STORY.sprintGoal}</h3>
              <span>Ends {STORY.sprintEnds}</span>
            </div>
            <div class="board">
              {STORY.board.columns.map(column => (
                <div class="col">
                  <h4>
                    {column.status}
                    <span>{column.cards.length}</span>
                  </h4>
                  {column.cards.map(card => (
                    <div class:list={['card', { sel: card.key === STORY.key }]}>
                      <span class="pts">{card.points}</span>
                      <span class="key">{card.key}</span>
                      <br />
                      {card.title}
                    </div>
                  ))}
                </div>
              ))}
            </div>
            <div class="activity">
              {STORY.board.activity.map(entry => (
                <p>
                  {entry.text}
                  <span class="t">{entry.day}</span>
                </p>
              ))}
            </div>
            <div class="wf-body et-note">
              <p>
                Focus the card, <kbd>Space</kbd> to pick it up, the arrow keys to move it, <kbd>Space</kbd> to drop.
                Fixed is a done status, so {STORY.key} is resolved and {lead.name.split(' ')[0]}, who filed it, is told.
              </p>
            </div>
          </div>

          <div data-view="agent">
            <p class="et-cap">
              <span class="et-n">6 / {total}</span>
              {dev.name.split(' ')[0]}’s agent, before standup · {STORY.standup.when}
            </p>
            <div class="et-agent">
              <div class="pane-bar">
                <span class="text-fg">Your agent</span>
                <span class="ml-auto">
                  connected as <span class="mono text-xs text-fg">@{dev.handle}</span>
                </span>
              </div>
              <p class="prompt">
                <span class="mark" aria-hidden="true">
                  ›
                </span>
                <span>Is anything still open on {STORY.key}?</span>
              </p>
              <ul class="calls" aria-label="Tool calls for the first request">
                <li>
                  <span class="tool">get_issue</span>
                  <span class="args">issue: "{STORY.key}"</span>
                </li>
              </ul>
              <div class="answer et-answer">
                <p>
                  <strong class="font-medium">{STORY.key}</strong> is {STORY.standup.status}, resolved{' '}
                  {STORY.standup.resolved}, with {STORY.standup.spent} spent of {STORY.estimate}.{' '}
                  {STORY.standup.dependencies.map(link => `${link.key}, which it depended on, is ${link.status} too.`)}{' '}
                  The decision record <em>{STORY.decision}</em> references it.
                </p>
              </div>
              <p class="prompt et-second">
                <span class="mark" aria-hidden="true">
                  ›
                </span>
                <span class="mono text-[13px]">{STANDUP_PROMPT}</span>
              </p>
              <ul class="calls" aria-label="Tool calls for the standup">
                <li>
                  <span class="tool">search_issues</span>
                  <span class="args">updated by: me updated: Yesterday .. Today sort by: updated desc</span>
                </li>
                <li>
                  <span class="tool">search_issues</span>
                  <span class="args">assignee: me #Unresolved</span>
                </li>
                <li>
                  <span class="tool">get_issue_activity</span>
                  <span class="args">issue: "{STORY.key}"</span>
                </li>
                <li>
                  <span class="tool">list_notifications</span>
                  <span class="args">unread_only: true</span>
                </li>
              </ul>
              <div class="answer et-answer">
                <dl class="et-standup">
                  <dt>Done</dt>
                  <dd>
                    <span class="key">{STORY.key}</span> {STORY.title}, now {STORY.standup.status}
                  </dd>
                  <dt>In progress</dt>
                  <dd>
                    {STORY.standup.inProgress.map(row => (
                      <>
                        <span class="key">{row.key}</span> {row.title}
                      </>
                    ))}
                  </dd>
                  <dt>Blocked or waiting</dt>
                  <dd>Nothing</dd>
                  <dt>Time logged</dt>
                  <dd class="mono text-xs">{STORY.standup.logged}</dd>
                  <dt>Waiting on you</dt>
                  <dd>Nothing unread</dd>
                </dl>
              </div>
              <p class="et-agent-foot">
                Every call here reads; nothing changed. Had {dev.name.split(' ')[0]} asked for a change, it would be
                made as <span class="mono text-xs text-fg">@{dev.handle}</span>, within {dev.name.split(' ')[0]}’s role
                and token.
              </p>
            </div>
          </div>
        </div>
        <p class="sr-only" aria-live="polite" data-et-status></p>
        <p class="mt-4 text-xs text-fg-3">
          Hand-drawn product views with fictional data. The issue never leaves the tracker: nothing here reads code,
          opens a pull request or deploys.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import '@scripts/solutions/engineering-teams';
</script>

<style>
  .wf-step .et-who {
    font-size: 12.5px;
    line-height: 18px;
    color: var(--text-secondary);
    margin-top: 1px;
  }
  .wf-step[aria-pressed='true'] .et-who {
    color: var(--text);
  }
  .et-cap {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 9px 16px;
    border-bottom: 1px solid var(--border);
    background: var(--bg-app);
    font-size: 12.5px;
    line-height: 18px;
    color: var(--text-secondary);
  }
  .et-n {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--text);
    flex: none;
  }
  .et-note {
    padding-top: 14px;
    padding-bottom: 16px;
    border-top: 1px solid var(--border);
    font-size: 13px;
    line-height: 20px;
    color: var(--text-secondary);
  }
  .et-tight {
    padding-top: 0;
    padding-bottom: 16px;
  }
  .et-tight .fields {
    margin-top: 0;
  }
  kbd {
    font-size: 12px;
    color: var(--text);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-bottom-width: 2px;
    border-radius: var(--radius-xs);
    padding: 0 5px;
  }
  .et-mention {
    font-size: 12.5px;
    color: var(--text);
    background: var(--bg-inset);
    padding: 0 4px;
    border-radius: 3px;
  }
  .et-ellipsis {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .et-spent {
    flex-wrap: wrap;
  }
  .et-meter {
    display: block;
    width: 96px;
    height: 4px;
    border-radius: var(--radius-full);
    background: var(--border);
    overflow: hidden;
  }
  .et-meter span {
    display: block;
    height: 100%;
    background: var(--text);
  }
  .et-bl + .et-bl {
    border-top: 1px solid var(--border);
  }
  .et-bl-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    padding: 10px 16px;
    font-size: 13px;
    line-height: 20px;
  }
  .et-pill {
    font-size: 11.5px;
    line-height: 18px;
    padding: 0 6px;
    border-radius: var(--radius-xs);
    background: var(--bg-inset);
    color: var(--text-secondary);
  }
  .et-bl-meta {
    margin-left: auto;
    font-size: 12.5px;
    color: var(--text-secondary);
  }
  .et-bl-row {
    display: grid;
    grid-template-columns: 10px 60px minmax(0, 1fr) auto;
    gap: 10px;
    align-items: center;
    min-height: 36px;
    padding: 7px 16px;
    border-top: 1px solid var(--border-subtle);
    font-size: 13px;
    line-height: 18px;
  }
  .et-dropped {
    background: var(--bg-selected);
    box-shadow: inset 2px 0 0 var(--accent);
  }
  .et-bl-title {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .et-grip {
    width: 6px;
    height: 12px;
    background-image: radial-gradient(var(--border-strong) 1px, transparent 1.2px);
    background-size: 3px 4px;
  }
  .et-pts {
    font-size: 12px;
    color: var(--text-secondary);
    white-space: nowrap;
  }
  .et-pts.et-none {
    color: var(--text-muted);
  }
  .et-bl-more {
    padding: 7px 16px 7px 36px;
    border-top: 1px solid var(--border-subtle);
    font-size: 12.5px;
    line-height: 18px;
    color: var(--text-secondary);
  }
  @media (max-width: 640px) {
    .et-bl-meta {
      flex-basis: 100%;
      margin-left: 0;
    }
    .et-bl-row {
      grid-template-columns: 10px 56px minmax(0, 1fr);
      row-gap: 2px;
    }
    .et-bl-title {
      white-space: normal;
    }
    .et-pts {
      grid-column: 3;
    }
  }
  .et-board-head {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 16px;
    padding: 10px 16px;
    border-bottom: 1px solid var(--border);
    font-size: 12.5px;
    line-height: 18px;
    color: var(--text-secondary);
  }
  .et-agent {
    background: var(--bg-app);
  }
  .et-answer {
    margin-top: 0;
    border-bottom: 1px solid var(--border);
  }
  .et-second {
    padding-top: 14px;
  }
  .et-standup {
    display: grid;
    grid-template-columns: 140px 1fr;
    row-gap: 6px;
    column-gap: 12px;
    font-size: 13.5px;
    line-height: 20px;
  }
  .et-standup dt {
    color: var(--text-secondary);
  }
  .et-standup dd {
    min-width: 0;
  }
  @media (max-width: 640px) {
    .et-standup {
      grid-template-columns: 1fr;
      row-gap: 0;
    }
    .et-standup dd + dt {
      margin-top: 8px;
    }
  }
  .et-agent-foot {
    padding: 12px 16px 14px;
    font-size: 12.5px;
    line-height: 18px;
    color: var(--text-secondary);
  }
</style>
