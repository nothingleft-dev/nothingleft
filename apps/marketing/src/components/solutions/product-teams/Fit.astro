---
import { FIT_POINTS } from '@lib/solutions/product-teams';
---

<section class="border-t border-line" aria-labelledby="pt-fit-title">
  <div class="wrap py-16 md:py-24 grid md:grid-cols-12 gap-10 md:gap-12">
    <div class="md:col-span-6 lg:col-span-5">
      <h2 id="pt-fit-title" class="h2">
        For product managers who plan in the same place engineering delivers.
      </h2>
      <p class="prose mt-5">
        One tracker for the backlog, the sprint and the reasons behind both, without a separate planning tool to keep in
        sync.
      </p>
      <div class="panel pt-best mt-8">
        <p class="pt-best-label">Best for</p>
        <p class="mt-1 text-base text-fg">
          Product teams that share delivery with engineering: one backlog, sprints planned together, decisions kept with
          the work.
        </p>
        <p class="pt-best-label mt-4">Not built for</p>
        <p class="mt-1 text-sm text-fg-2">
          Portfolio roadmaps across many products, public feedback portals or roadmaps, and automatic scoring of
          requests.
        </p>
      </div>
      <p class="mt-6 text-sm text-fg-2">
        Free for any team size during beta; the first 20 members of every organisation stay free.
      </p>
      <p class="mt-3 flex flex-wrap gap-x-6 gap-y-3 text-sm">
        <a class="link" href="/pricing">
          Pricing
          <span class="arr" aria-hidden="true">
            →
          </span>
        </a>
        <a class="link" href="/docs">
          Read the docs
          <span class="arr" aria-hidden="true">
            →
          </span>
        </a>
      </p>
    </div>
    <div class="md:col-span-6 lg:col-span-6 lg:col-start-7">
      <p class="text-sm font-medium">What it gives a product manager</p>
      <div class="rule-list mt-3">
        {FIT_POINTS.map(point => (
          <div class="py-5">
            <h3 class="h3">{point.title}</h3>
            <p class="prose mt-1 text-base">{point.body}</p>
            <a class="link text-sm mt-3 inline-block" href={point.link.href}>
              {point.link.label}
              <span class="arr" aria-hidden="true">
                →
              </span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .pt-best {
    padding: 18px 20px;
    border-left: 2px solid var(--accent);
  }
  .pt-best-label {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-secondary);
  }
</style>
