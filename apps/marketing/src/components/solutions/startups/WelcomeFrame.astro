---
import { WELCOME_RAIL } from '@lib/solutions/startups';

interface Props {
  current: number;
  title: string;
  lede: string;
}

const { current, title, lede } = Astro.props;
---

<div class="su-frame">
  <ol class="su-rail" aria-label="Onboarding steps">
    {WELCOME_RAIL.map((step, index) => (
      <li class:list={{ done: index < current, now: index === current }}>
        <span class="pip" aria-hidden="true" />
        <span>
          <b>{step.title}</b>
          <span>{step.body}</span>
        </span>
      </li>
    ))}
  </ol>
  <div class="su-step">
    <p class="text-xs text-fg-3">
      Step {current + 1} of {WELCOME_RAIL.length}
    </p>
    <p class="su-step-title">{title}</p>
    <p class="su-step-lede">{lede}</p>
    <div class="su-step-body">
      <slot />
    </div>
    <div class="su-step-foot">
      <slot name="foot" />
    </div>
  </div>
</div>

<style>
  .su-frame {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 768px) {
    .su-frame {
      grid-template-columns: 200px minmax(0, 1fr);
    }
  }
  .su-rail {
    display: none;
    padding: 18px 16px;
    background: var(--bg-app);
    border-right: 1px solid var(--border);
  }
  @media (min-width: 768px) {
    .su-rail {
      display: block;
    }
  }
  .su-rail li {
    display: grid;
    grid-template-columns: 10px minmax(0, 1fr);
    gap: 10px;
    padding: 8px 0;
    font-size: 12.5px;
    line-height: 18px;
    color: var(--text-muted);
  }
  .su-rail b {
    display: block;
    font-weight: 500;
    color: var(--text-secondary);
  }
  .su-rail .pip {
    width: 8px;
    height: 8px;
    margin-top: 5px;
    border-radius: 2px;
    box-shadow: inset 0 0 0 1.5px var(--border-strong);
  }
  .su-rail .done .pip {
    background: var(--text-secondary);
    box-shadow: none;
  }
  .su-rail .now .pip {
    background: var(--accent);
    box-shadow: inset 0 0 0 1.5px var(--text);
  }
  .su-rail .now b {
    color: var(--text);
    font-weight: 600;
  }
  .su-rail .now > span > span {
    color: var(--text-secondary);
  }
  .su-step {
    padding: 20px 20px 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .su-step-title {
    margin-top: 6px;
    font-size: 19px;
    line-height: 25px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .su-step-lede {
    margin-top: 4px;
    font-size: 13.5px;
    line-height: 20px;
    color: var(--text-secondary);
  }
  .su-step-body {
    margin-top: 18px;
    display: grid;
    gap: 14px;
    max-width: 420px;
  }
  .su-step-foot {
    margin: 22px -20px 0;
    padding: 12px 20px;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
</style>
