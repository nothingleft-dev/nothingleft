---
import { GROWTH_STEPS } from '@lib/solutions/startups';
---

<section class="border-t border-line bg-app" aria-labelledby="growth-title">
  <div class="wrap py-16 md:py-24">
    <div class="max-w-[640px]">
      <h2 id="growth-title" class="h2">
        Add structure when the work asks for it.
      </h2>
      <p class="prose mt-5">
        The same project, the same issue keys, the same people. Each of these is already there in the project; you start
        using it when a plain list is no longer enough.
      </p>
    </div>
    <ol class="su-growth mt-10 md:mt-14">
      {GROWTH_STEPS.map(step => (
        <li>
          <p class="text-xs text-fg-3">{step.when}</p>
          <h3 class="h3 mt-2">{step.title}</h3>
          <p class="prose mt-2 text-base">{step.body}</p>
          <a class="link text-sm mt-4 self-start" href={step.href}>
            {step.label}
            <span class="arr" aria-hidden="true">
              →
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .su-growth {
    display: grid;
    border-top: 1px solid var(--border);
  }
  .su-growth li {
    display: flex;
    flex-direction: column;
    padding: 22px 0 26px;
    border-bottom: 1px solid var(--border);
    min-width: 0;
  }
  @media (min-width: 768px) {
    .su-growth {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 40px;
    }
  }
  @media (min-width: 1200px) {
    .su-growth {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: 32px;
    }
    .su-growth li {
      border-bottom: 0;
    }
  }
</style>
