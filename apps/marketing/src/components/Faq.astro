---
import type { FaqEntry } from '@lib/faq';
import { SIGN_UP_URL } from '@lib/site';

interface Props {
  entries: FaqEntry[];
  title?: string;
  intro?: string;
  askHref?: string;
  /** Off on pages that close with their own call to action, so the page has one ending. */
  signup?: boolean;
}

const {
  entries,
  title = 'Before you bring your team.',
  intro = 'The questions that decide whether a trial is worth your week. Short answers here, details in the docs.',
  askHref = '/support',
  signup = true,
} = Astro.props;
---

<section id="faq" class="border-t border-line" aria-labelledby="faq-title">
  <div class="wrap py-16 md:py-24 grid lg:grid-cols-12 gap-10 lg:gap-12">
    <div class="lg:col-span-4">
      <h2 id="faq-title" class="h2">
        {title}
      </h2>
      <p class="prose mt-5 max-w-[40ch]">{intro}</p>
    </div>
    <div class="lg:col-span-7 lg:col-start-6 faq">
      {entries.map(entry => (
        <details name="faq">
          <summary>
            {entry.question}
            <span class="plus" aria-hidden="true" />
          </summary>
          <div class="a prose text-base">
            {entry.answer.map((paragraph, index) => (
              <p>
                {paragraph}
                {entry.link && index === entry.answer.length - 1 && (
                  <>
                    {' '}
                    <a class="link" href={entry.link.href}>
                      {entry.link.label}
                      <span class:list={['arr', { ext: entry.link.external }]} aria-hidden="true">
                        {entry.link.external ? '↗' : '→'}
                      </span>
                    </a>
                  </>
                )}
              </p>
            ))}
          </div>
        </details>
      ))}
      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3">
        {signup && (
          <a class="btn" href={SIGN_UP_URL}>
            Join the beta
            <span class="arr" aria-hidden="true">
              →
            </span>
          </a>
        )}
        <a class="link text-sm" href={askHref}>
          Ask something else
          <span class="arr" aria-hidden="true">
            →
          </span>
        </a>
      </div>
    </div>
  </div>
</section>
