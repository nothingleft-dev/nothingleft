---
interface Props {
  size?: 'large' | 'compact';
  id: string;
}

const { size = 'compact', id } = Astro.props;
---

<div class:list={['docs-search', `docs-search-${size}`]} data-docs-search hidden>
  <label class="sr-only" for={id}>
    Search the docs
  </label>
  <div class="input-box docs-search-box">
    <svg
      width="15"
      height="15"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <circle cx="7" cy="7" r="4.5"></circle>
      <path d="m10.5 10.5 3 3"></path>
    </svg>
    <input
      id={id}
      type="search"
      autocomplete="off"
      spellcheck="false"
      placeholder={size === 'large' ? 'Search tokens, sprints, two-factor…' : 'Search the docs'}
      aria-controls={`${id}-results`}
      aria-expanded="false"
      data-search-input
    />
    <button type="button" class="docs-search-clear" aria-label="Clear the search" data-search-clear hidden>
      <svg
        width="12"
        height="12"
        viewBox="0 0 12 12"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path d="m3 3 6 6M9 3l-6 6"></path>
      </svg>
    </button>
    {size === 'compact' && (
      <kbd class="docs-kbd" aria-hidden="true">
        /
      </kbd>
    )}
  </div>
  <p class="sr-only" aria-live="polite" data-search-status></p>
  <ul id={`${id}-results`} class="docs-search-results" data-search-results hidden></ul>
</div>

<style>
  .docs-search {
    position: relative;
  }
  .docs-search-box {
    color: var(--text-muted);
  }
  .docs-search-large .docs-search-box {
    height: 48px;
    padding: 0 16px;
  }
  .docs-search-large input {
    font-size: 16px;
  }
  .docs-kbd {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
    padding: 0 6px;
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    color: var(--text-muted);
  }
  .docs-search input::-webkit-search-cancel-button {
    appearance: none;
  }
  .docs-search-clear {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 24px;
    height: 24px;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
  }
  .docs-search-clear[hidden] {
    display: none;
  }
  .docs-search-clear:hover {
    background: var(--bg-hover);
    color: var(--text);
  }
  .docs-search-box:has(.docs-search-clear:not([hidden])) .docs-kbd {
    display: none;
  }
  .docs-search-results {
    position: absolute;
    z-index: 30;
    left: 0;
    right: 0;
    top: calc(100% + 6px);
    max-height: min(60vh, 420px);
    overflow-y: auto;
    background: var(--bg-raised);
    box-shadow: var(--shadow-popover);
    border-radius: var(--radius-md);
    padding: 6px;
  }
  .docs-search-results :global(a) {
    display: block;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    color: var(--text);
    text-decoration: none;
  }
  .docs-search-results :global(a:hover),
  .docs-search-results :global(a:focus-visible) {
    background: var(--bg-hover);
  }
  .docs-search-results :global(.result-title) {
    display: block;
    font-size: 14px;
    font-weight: 500;
  }
  .docs-search-results :global(.result-excerpt) {
    display: block;
    margin-top: 2px;
    font-size: 13px;
    line-height: 19px;
    color: var(--text-secondary);
  }
  .docs-search-results :global(mark) {
    background: var(--accent-soft);
    color: var(--text);
    border-radius: 2px;
  }
  .docs-search-results :global(.result-empty) {
    padding: 10px 12px;
    font-size: 13px;
    color: var(--text-secondary);
  }
  .docs-search-results :global(.result-retry) {
    font-weight: 500;
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
