---
import { Heart, Lightbulb, ThumbsDown, ThumbsUp } from '@lucide/astro';
import { REACTIONS, type ReactionId } from '@lib/reactions-contract';

interface Props {
  article: string;
}

const { article } = Astro.props;
const ICONS: Record<ReactionId, typeof ThumbsUp> = {
  helpful: ThumbsUp,
  clear: Lightbulb,
  loved: Heart,
  'not-helpful': ThumbsDown,
};
---

<section class="docs-reactions" aria-labelledby="reactions-title" data-docs-reactions={article} hidden>
  <p id="reactions-title" class="docs-reactions-title">
    Was this page useful?
  </p>
  <div class="docs-reactions-row" role="group" aria-labelledby="reactions-title">
    {REACTIONS.map(reaction => {
      const Icon = ICONS[reaction.id];
      return (
        <button type="button" class="reaction" aria-pressed="false" data-reaction={reaction.id}>
          <Icon size={16} stroke-width={1.75} aria-hidden="true" />
          <span>{reaction.label}</span>
          <span class="reaction-count" data-count>
            –
          </span>
        </button>
      );
    })}
  </div>
  <p class="docs-reactions-status" aria-live="polite" data-reaction-status></p>
</section>

<style>
  .docs-reactions-title {
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
  }
  .docs-reactions-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }
  .reaction {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    padding: 0 12px;
    border-radius: var(--radius-full);
    font-size: 13px;
    color: var(--text-secondary);
    box-shadow: inset 0 0 0 1px var(--border);
    background: var(--bg-surface);
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }
  .reaction:hover {
    color: var(--text);
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }
  .reaction[aria-pressed='true'] {
    color: var(--text);
    background: var(--accent-soft);
    box-shadow: inset 0 0 0 1px var(--accent);
  }
  .reaction:disabled {
    cursor: progress;
  }
  .reaction-count {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .reaction[aria-pressed='true'] .reaction-count {
    color: var(--text);
  }
  .docs-reactions-status {
    margin-top: 8px;
    min-height: 18px;
    font-size: 13px;
    color: var(--text-secondary);
  }
</style>
