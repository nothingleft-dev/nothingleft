---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const entries = Astro.props.headings.filter(heading => heading.depth === 2 || heading.depth === 3);
---

{entries.length > 0 && (
  <nav aria-label="On this page" class="docs-toc" data-docs-toc>
    <p class="docs-toc-title">On this page</p>
    <ul>
      {entries.map(heading => (
        <li class:list={{ sub: heading.depth === 3 }}>
          <a href={`#${heading.slug}`} data-toc-link={heading.slug}>
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .docs-toc {
    font-size: 13px;
    line-height: 19px;
  }
  .docs-toc-title {
    font-weight: 500;
    color: var(--text);
    margin-bottom: 8px;
  }
  .docs-toc ul {
    border-left: 1px solid var(--border);
  }
  .docs-toc a {
    display: block;
    padding: 4px 0 4px 12px;
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--text-secondary);
    text-decoration: none;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .docs-toc .sub a {
    padding-left: 24px;
  }
  .docs-toc a:hover {
    color: var(--text);
  }
  .docs-toc a[aria-current='true'] {
    color: var(--text);
    border-left-color: var(--accent);
  }
</style>
