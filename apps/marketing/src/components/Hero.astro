---
import Demo from '@components/Demo.astro';
import { GITHUB_URL, SIGN_UP_URL } from '@lib/site';
---

<section class="wrap pt-12 md:pt-16 pb-12 md:pb-16" aria-labelledby="hero-title">
  <div class="max-w-[820px]">
    <p class="text-sm md:text-base text-fg-2">Open-source project tracking for product and engineering teams</p>
    <h1 id="hero-title" class="h1 mt-4 md:mt-5">
      Nothing left hanging<span class="period">.</span>
    </h1>
    <p class="prose mt-6 md:mt-8 max-w-[580px] text-[17px] leading-[27px] md:text-[19px] md:leading-[30px]">
      Track issues, plan sprints and keep project decisions together. Connect your AI agent to find and update work with
      the permissions you choose.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
      <a class="btn" href={SIGN_UP_URL}>
        Join the beta
        <span class="arr" aria-hidden="true">
          →
        </span>
      </a>
      <a class="link text-sm" id="watch" href="#demo-figure">
        Watch the workflow
        <span class="arr" aria-hidden="true">
          ↓
        </span>
      </a>
    </div>
    <p class="mt-5 text-xs text-fg-3">
      Free during beta. Your first 20 members stay free forever. AGPL-3.0,{' '}
      <a class="link font-normal" href={GITHUB_URL}>
        source on GitHub
        <span class="arr ext" aria-hidden="true">
          ↗
        </span>
      </a>
    </p>
  </div>

  <Demo class="mt-12 md:mt-14" />
</section>
