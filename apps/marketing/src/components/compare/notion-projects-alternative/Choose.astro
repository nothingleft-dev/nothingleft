---
import { KB_FEATURE_PATH, NOTION, SPRINTS_FEATURE_PATH } from '@lib/compare/notion-projects-alternative';

const chooseNotion = [
  {
    text: 'Most of your team’s work is writing: specs, meeting notes, a company wiki, pages several teams share.',
    href: NOTION.wikis,
    label: 'Wikis',
  },
  {
    text: 'You want to design your own databases, properties and views for each team, not adopt a fixed issue model.',
    href: NOTION.views,
    label: 'Views',
  },
  {
    text: 'You want an AI assistant built into the workspace that drafts pages and answers from your connected apps.',
    href: NOTION.ai,
    label: 'Notion AI',
  },
  {
    text: 'You publish pages to the web, or rely on database automations that send webhooks, emails or Slack messages.',
    href: NOTION.automations,
    label: 'Automations',
  },
];

const chooseUs = [
  'Bugs and sprints are the daily work, and you want keys, links, sprint state, burndown and time logs on every issue without building them.',
  'You want reports scoped by the same query language as search, with each figure opening the issues it counts.',
  'Your project runbooks and decision records should sit next to the issues they name and stay private to the project.',
  'You want your own agent to work through documented MCP tools, or you want to self-host the AGPL-3.0 build.',
];
---

<section id="np-choose" class="border-t border-line" aria-labelledby="np-choose-title">
  <div class="wrap py-16 md:py-24">
    <div class="max-w-[680px]">
      <h2 id="np-choose-title" class="h2">
        Which one fits, or both.
      </h2>
      <p class="prose mt-5">
        These are different tools. Notion is a workspace in which a team can build project tracking; Nothing Left is
        project tracking with a small knowledge base attached. Choose by where most of your team’s day goes.
      </p>
    </div>

    <div class="mt-10 md:mt-14 grid md:grid-cols-2 gap-x-10 lg:gap-x-12 gap-y-10">
      <div>
        <h3 class="h3">Choose Notion if…</h3>
        <ul class="np-list mt-4">
          {chooseNotion.map(item => (
            <li>
              {item.text}{' '}
              <a class="link font-normal np-src" href={item.href} rel="noopener">
                {item.label}
                <span class="arr ext" aria-hidden="true">
                  ↗
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="h3">Choose Nothing Left if…</h3>
        <ul class="np-list mt-4">
          {chooseUs.map(item => (
            <li>{item}</li>
          ))}
        </ul>
        <p class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm">
          <a class="link" href={SPRINTS_FEATURE_PATH}>
            Sprints and boards
            <span class="arr" aria-hidden="true">
              →
            </span>
          </a>
          <a class="link" href={KB_FEATURE_PATH}>
            Project knowledge base
            <span class="arr" aria-hidden="true">
              →
            </span>
          </a>
        </p>
      </div>
    </div>

    <div id="np-both" class="panel panel-pad mt-12 md:mt-16 grid lg:grid-cols-12 gap-6 lg:gap-12">
      <div class="lg:col-span-5">
        <p class="np-eyebrow">The third option</p>
        <h3 class="h3 mt-2">Use both: issues here, shared docs in Notion.</h3>
      </div>
      <div class="lg:col-span-7 prose text-[15px] leading-[24px]">
        <p>
          Run bugs, sprints, time and reports in Nothing Left, and keep the company wiki, plans and cross-team pages in
          Notion. Write the project’s own runbooks and decision records in its knowledge base if you want an issue to
          list them under Referenced by.
        </p>
        <p class="mt-3">
          There is no built integration between the two. A link from a Notion page to an issue, or from an issue to a
          Notion page, is an ordinary link, and nothing is kept in sync.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .np-list li {
    position: relative;
    padding: 12px 0 12px 18px;
    border-top: 1px solid var(--border);
    font-size: 15px;
    line-height: 24px;
    color: var(--text-secondary);
  }
  .np-list li:last-child {
    border-bottom: 1px solid var(--border);
  }
  .np-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 21px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--border-strong);
  }
  .np-src {
    font-size: 13px;
    white-space: nowrap;
  }
  .np-eyebrow {
    font-size: 13px;
    line-height: 18px;
    color: var(--text-secondary);
  }
</style>
