---
import Demo from '@components/Demo.astro';
---

<section class="border-t border-line bg-app" aria-labelledby="triage-title">
  <div class="wrap py-16 md:py-24">
    <div class="max-w-[640px]">
      <h2 id="triage-title" class="h2">
        One request, done the way you would do it.
      </h2>
      <p class="prose mt-5">
        A triage request becomes a search, an update and a time log against the same API the app uses. The issue list
        changes as each call lands. Open the tool calls to see exactly what was sent.
      </p>
    </div>
    <Demo class="mt-10 md:mt-14" />
  </div>
</section>
