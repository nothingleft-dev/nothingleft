---
import { TOOL_AREAS, TOOL_REFERENCE_PATH } from '@lib/mcp';
---

<section class="border-t border-line bg-app" aria-labelledby="areas-title">
  <div class="wrap py-16 md:py-24">
    <div class="max-w-[640px]">
      <h2 id="areas-title" class="h2">
        Everything you can do in the app, except handle credentials.
      </h2>
      <p class="prose mt-5">
        The tools cover the product, not a showcase subset. A test in the open repository fails when an API route has
        neither a tool nor a stated reason to have none.
      </p>
    </div>
    <ul class="areas mt-10 md:mt-14">
      {TOOL_AREAS.map(item => (
        <li>
          <h3 class="text-sm font-medium">{item.area}</h3>
          <p class="mt-1 text-sm text-fg-2">{item.detail}</p>
        </li>
      ))}
    </ul>
    <p class="mt-8 text-sm">
      <a class="link" href={TOOL_REFERENCE_PATH}>
        Every tool, with its arguments
        <span class="arr" aria-hidden="true">
          →
        </span>
      </a>
    </p>
  </div>
</section>
