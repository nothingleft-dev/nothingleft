---
interface Props {
  duration: string;
  workType: string;
  date?: string;
  range?: { from: string; to: string };
  author?: { name: string; initials: string };
  note?: string;
  result?: string;
}

const { duration, workType, date, range, author, note, result } = Astro.props;
---

<div class="log">
  <div class="log-mode">
    <span class:list={{ on: !range }}>Date</span>
    <span class:list={{ on: !!range }}>Date range</span>
  </div>
  <dl class="log-fields">
    {author && (
      <>
        <dt>Author</dt>
        <dd>
          <span class="box">
            <span class="av">{author.initials}</span>
            {author.name}
          </span>
        </dd>
      </>
    )}
    {range ? (
      <>
        <dt>From</dt>
        <dd>
          <span class="box">{range.from}</span>
        </dd>
        <dt>To</dt>
        <dd>
          <span class="box">{range.to}</span>
        </dd>
      </>
    ) : (
      <>
        <dt>Date</dt>
        <dd>
          <span class="box">{date}</span>
        </dd>
      </>
    )}
    <dt>Time spent</dt>
    <dd>
      <span class="box mono">{duration}</span>
    </dd>
    <dt>Type</dt>
    <dd>
      <span class="box">
        {workType}
        <span class="chev" aria-hidden="true">
          ⌄
        </span>
      </span>
    </dd>
    {note && (
      <>
        <dt>Note</dt>
        <dd>
          <span class="box note">{note}</span>
        </dd>
      </>
    )}
  </dl>
  {result && <p class="log-result">{result}</p>}
  <div class="log-foot">
    <span class="add-another">+ Add another record</span>
    <span class="fake-btn">Add spent time</span>
  </div>
</div>

<style>
  .log {
    padding: 14px 16px 16px;
  }
  .log-mode {
    display: inline-flex;
    padding: 2px;
    border-radius: var(--radius-sm);
    background: var(--bg-inset);
    font-size: 12.5px;
    line-height: 18px;
  }
  .log-mode span {
    padding: 3px 10px;
    border-radius: var(--radius-xs);
    color: var(--text-secondary);
  }
  .log-mode .on {
    background: var(--bg-surface);
    color: var(--text);
    box-shadow: 0 0 0 1px var(--border);
  }
  .log-fields {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr);
    align-items: center;
    row-gap: 8px;
    column-gap: 12px;
    margin-top: 14px;
    font-size: 13px;
  }
  .log-fields dt {
    color: var(--text-muted);
  }
  .log-fields dd {
    min-width: 0;
  }
  .box {
    display: flex;
    align-items: center;
    gap: 7px;
    min-height: 30px;
    padding: 4px 9px;
    border-radius: var(--radius-sm);
    box-shadow: inset 0 0 0 1px var(--border-strong);
    color: var(--text);
    line-height: 20px;
  }
  .box.mono {
    font-size: 12.5px;
  }
  .box.note {
    align-items: flex-start;
    color: var(--text-secondary);
  }
  .chev {
    margin-left: auto;
    color: var(--text-muted);
    line-height: 1;
    transform: translateY(-3px);
  }
  .log-result {
    margin-top: 12px;
    font-size: 12.5px;
    line-height: 18px;
    color: var(--text-secondary);
  }
  .log-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--border-subtle);
  }
  .add-another {
    font-size: 12.5px;
    color: var(--text-secondary);
  }
  .fake-btn {
    display: inline-flex;
    align-items: center;
    height: 28px;
    padding: 0 10px;
    border-radius: var(--radius-sm);
    background: var(--ink);
    color: var(--ink-fg);
    font-size: 12.5px;
    font-weight: 500;
    white-space: nowrap;
  }
</style>
