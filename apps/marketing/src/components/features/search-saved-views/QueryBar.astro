---
interface Props {
  count?: string;
  queryId?: string;
  countId?: string;
  caret?: boolean;
}

const { count, queryId, countId, caret = false } = Astro.props;
---

<div class="qbar">
  <span class="glyph" aria-hidden="true">
    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
      <circle cx="7" cy="7" r="4.5"></circle>
      <path d="m10.5 10.5 3 3"></path>
    </svg>
  </span>
  <span class="q" id={queryId}>
    <slot />
    {caret && <span class="caret" aria-hidden="true" />}
  </span>
  {count !== undefined && (
    <span class="count" id={countId}>
      {count}
    </span>
  )}
</div>

<style>
  .qbar {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    min-height: 40px;
    padding: 10px 16px;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
  }
  .glyph {
    flex: none;
    margin-top: 3px;
    color: var(--text-muted);
  }
  .q {
    font-variant-ligatures: none;
    min-width: 0;
    flex: 1;
    overflow-wrap: anywhere;
  }
  .caret {
    display: inline-block;
    vertical-align: -3px;
    margin-left: 1px;
  }
  .count {
    flex: none;
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--text-muted);
    white-space: nowrap;
  }
</style>
