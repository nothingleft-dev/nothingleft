---
import { countLabel, DEFAULT_STATE, runQuery } from '@lib/features/search-saved-views';
import IssueRow from './IssueRow.astro';
import QueryBar from './QueryBar.astro';

const { query, issues } = runQuery(DEFAULT_STATE);

const readings = [
  { clause: 'type: Bug', meaning: 'Only bugs. Separate values with a comma to accept either: `type: Bug, Task`.' },
  {
    clause: '#Unresolved',
    meaning: 'In any unresolved status, whatever each project calls it. `#Resolved` is the opposite.',
  },
  {
    clause: 'assignee: me',
    meaning: 'Assigned to whoever runs it. For Alex Lee that is `@alex`; for an agent, the person who owns its token.',
  },
];
---

<section class="pb-16 md:pb-24" aria-labelledby="reads-title">
  <div class="wrap grid lg:grid-cols-12 gap-8 lg:gap-12 items-start">
    <figure class="lg:col-span-7 min-w-0">
      <div class="panel overflow-hidden">
        <div class="pane-bar">
          <span class="text-fg">Acme</span>
          <span class="sep">/</span>
          <span>Issues</span>
          <span class="av ml-auto" title="Alex Lee">
            AL
          </span>
        </div>
        <QueryBar count={countLabel(issues.length)}>{query}</QueryBar>
        <ul class="list-none" aria-label="Matching issues">
          {issues.map(issue => (
            <IssueRow issue={issue} />
          ))}
        </ul>
      </div>
      <figcaption class="mt-3 text-xs text-fg-3">
        A hand-drawn search with fictional data, signed in as Alex Lee.
      </figcaption>
    </figure>
    <div class="lg:col-span-5">
      <h2 id="reads-title" class="h3">
        How the query reads
      </h2>
      <dl class="rule-list mt-4">
        {readings.map(reading => (
          <div class="py-4">
            <dt>
              <code class="clause">{reading.clause}</code>
            </dt>
            <dd class="mt-2 text-sm text-fg-2">
              {reading.meaning.split('`').map((part, index) => (index % 2 ? <code class="clause">{part}</code> : part))}
            </dd>
          </div>
        ))}
      </dl>
      <p class="mt-4 text-sm text-fg-2">
        Clauses side by side must all match. Nothing is case-sensitive: <code class="clause">type: bug</code> is the
        same search.
      </p>
    </div>
  </div>
</section>

<style>
  code,
  pre {
    font-variant-ligatures: none;
  }
  .clause {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--text);
    background: var(--bg-inset);
    padding: 1px 6px;
    border-radius: var(--radius-xs);
  }
</style>
