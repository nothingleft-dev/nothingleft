---
import { AGILE_MANUAL_PATH } from '@lib/features/sprints-kanban-boards';

const FITS = [
  'A team that plans one sprint at a time in each project, with a goal and story points.',
  'People who want the backlog, the board and the burndown to tell the same story about a sprint.',
  'Teams whose AI agent should plan and move work with the same permissions as they have.',
];

const LIMITS = [
  'Portfolio planning across projects. A sprint belongs to one project, and so does a board.',
  'Automatic sprint planning or velocity forecasts. You choose the work; the burndown records what happened.',
  'Status changes from commits, pull requests or deployments. Cards move when someone moves them.',
];
---

<section class="border-t border-line bg-app" aria-labelledby="fit-title">
  <div class="wrap py-16 md:py-24 grid md:grid-cols-12 gap-10 md:gap-12">
    <div class="md:col-span-6 lg:col-span-5">
      <h2 id="fit-title" class="h2">
        Made for sprint and board work, one project at a time.
      </h2>
      <p class="prose mt-5">
        Teams that plan in sprints and follow them on a board get a backlog, sprints, boards and a burndown that agree
        with each other, one project at a time. It is not an enterprise portfolio planner.
      </p>
      <p class="mt-5 text-sm">
        <a class="link" href={AGILE_MANUAL_PATH}>
          Read the sprints and boards manual
          <span class="arr" aria-hidden="true">
            →
          </span>
        </a>
      </p>
    </div>
    <div class="md:col-span-6 lg:col-span-6 lg:col-start-7 space-y-10">
      <div>
        <h3 class="text-sm font-medium">A good fit for</h3>
        <ul class="rule-list mt-3">
          {FITS.map(item => (
            <li class="py-4 prose text-base">{item}</li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-medium">Not built for</h3>
        <ul class="rule-list mt-3">
          {LIMITS.map(item => (
            <li class="py-4 prose text-base">{item}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
