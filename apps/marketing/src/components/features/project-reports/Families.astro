---
import { REPORT_FAMILIES, REPORTS_MANUAL_PATH } from '@lib/features/project-reports';
---

<section id="nine" class="border-t border-line" aria-labelledby="nine-title">
  <div class="wrap py-16 md:py-24 grid lg:grid-cols-12 gap-10 lg:gap-12">
    <div class="lg:col-span-4">
      <h2 id="nine-title" class="h2">
        Nine reports, three questions.
      </h2>
      <p class="prose mt-5 max-w-[40ch]">
        Each has a table under its chart, opens the issues it counted and exports to CSV. Every issue report takes the
        same scope: a query, a saved view, projects.
      </p>
      <p class="mt-6 text-sm">
        <a class="link" href={REPORTS_MANUAL_PATH}>
          How each report counts
          <span class="arr" aria-hidden="true">
            →
          </span>
        </a>
      </p>
    </div>
    <div class="lg:col-span-7 lg:col-start-6 grid gap-10">
      {REPORT_FAMILIES.map(family => (
        <div>
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <h3 class="h3">{family.name}</h3>
            <p class="text-sm text-fg-2">{family.question}</p>
          </div>
          <ul class="rule-list mt-4">
            {family.reports.map(report => (
              <li class="report">
                <span class="report-name">{report.name}</span>
                <span class="report-detail">{report.detail}</span>
              </li>
            ))}
          </ul>
          <a class="link text-sm mt-4 inline-block" href={family.link.href}>
            {family.link.label}
            <span class="arr" aria-hidden="true">
              →
            </span>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .report {
    display: grid;
    gap: 2px 24px;
    padding: 14px 0;
  }
  @media (min-width: 640px) {
    .report {
      grid-template-columns: 168px minmax(0, 1fr);
    }
  }
  .report-name {
    font-size: 15px;
    line-height: 22px;
    font-weight: 500;
    color: var(--text);
  }
  .report-detail {
    font-size: 14.5px;
    line-height: 22px;
    color: var(--text-secondary);
  }
</style>
