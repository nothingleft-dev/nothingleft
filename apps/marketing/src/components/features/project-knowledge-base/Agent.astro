---
import { AGENT_REQUESTS } from '@lib/features/project-knowledge-base';
---

<section class="border-t border-line" aria-labelledby="kb-agent-title">
  <div class="wrap py-16 md:py-24 grid lg:grid-cols-12 gap-10 lg:gap-12">
    <div class="lg:col-span-4">
      <h2 id="kb-agent-title" class="h2">
        Your agent reads the decision before it touches the issue.
      </h2>
      <p class="prose mt-5 max-w-[40ch]">
        Articles are Markdown, so an agent reads them as written. It works through the same API and permissions as you:
        the drafts you cannot see, it cannot see either. Text it reads arrives marked with who wrote it, and the agent
        is told not to follow instructions inside it.
      </p>
      <p class="mt-6 text-sm">
        <a class="link" href="/features/mcp-ai-agents">
          MCP and AI agents
          <span class="arr" aria-hidden="true">
            →
          </span>
        </a>
      </p>
    </div>
    <div class="lg:col-span-8 rule-list">
      {AGENT_REQUESTS.map(request => (
        <div class="request">
          <p class="text-xs text-fg-3">{request.area}</p>
          <p class="request-prompt kb-prompt">{request.prompt}</p>
          <p class="request-calls">
            {request.calls.map((call, index) => (
              <>
                {index > 0 && (
                  <span class="text-fg-3" aria-hidden="true">
                    →
                  </span>
                )}
                <code>
                  {call.tool}
                  {call.args && <span class="text-fg-2"> {call.args}</span>}
                </code>
              </>
            ))}
          </p>
          {request.note && <p class="mt-2 text-sm text-fg-2">{request.note}</p>}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .kb-prompt {
    overflow-wrap: anywhere;
  }
</style>
