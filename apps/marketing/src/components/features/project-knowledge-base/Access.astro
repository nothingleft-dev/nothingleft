---
import { ACCESS_ROWS } from '@lib/features/project-knowledge-base';
---

<section class="border-t border-line bg-app" aria-labelledby="kb-access-title">
  <div class="wrap py-16 md:py-24 grid lg:grid-cols-12 gap-10 lg:gap-12">
    <div class="lg:col-span-5">
      <h2 id="kb-access-title" class="h2">
        Internal to the project, with no public pages.
      </h2>
      <p class="prose mt-5 max-w-[46ch]">
        Only the project's members can read its knowledge base. There is no public publishing, no share-with-anyone link
        and no anonymous access. In an archived project, it becomes read-only.
      </p>
    </div>
    <div class="lg:col-span-6 lg:col-start-7">
      <div class="rule-list">
        <div class="py-6">
          <h3 class="h3">A draft is yours until you publish it.</h3>
          <p class="prose mt-2 text-base">
            A new article is a draft: only you and the project's admins can see it. A one-line notice on the article
            says so.
          </p>
        </div>
        <div class="py-6">
          <h3 class="h3">Published means every project member.</h3>
          <p class="prose mt-2 text-base">
            Publish it and everyone in the project can read it, Observers included. Return it to draft at any time; it
            remembers when it was last published.
          </p>
        </div>
      </div>

      <table class="kb-table mt-8">
        <caption class="text-left text-sm font-medium text-fg pb-3">Who can do what</caption>
        <thead>
          <tr>
            <th scope="col">
              <span class="sr-only">Action</span>
            </th>
            <th scope="col">Observer</th>
            <th scope="col">Contributor</th>
            <th scope="col">Project Admin and up</th>
          </tr>
        </thead>
        <tbody>
          {ACCESS_ROWS.map(row => (
            <tr>
              <th scope="row">{row.action}</th>
              {[row.observer, row.contributor, row.admin].map(value => (
                <td class:list={{ 'kb-no': value === 'No' }}>{value}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
      <p class="mt-3 text-xs text-fg-2">
        <em>Own</em> means the articles you wrote. Someone else's draft is not shown to a Contributor at all.
      </p>
    </div>
  </div>
</section>

<style>
  .kb-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
    line-height: 20px;
  }
  .kb-table th,
  .kb-table td {
    padding: 9px 8px;
    border-bottom: 1px solid var(--border-subtle);
    text-align: center;
    vertical-align: top;
  }
  .kb-table thead th {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-secondary);
    border-bottom-color: var(--border);
    border-top: 1px solid var(--border);
  }
  .kb-table tbody th {
    text-align: left;
    font-weight: 400;
    color: var(--text);
    padding-left: 0;
  }
  .kb-table td {
    color: var(--text);
  }
  .kb-table .kb-no {
    color: var(--text-muted);
  }
  @media (max-width: 480px) {
    .kb-table {
      font-size: 12.5px;
    }
    .kb-table th,
    .kb-table td {
      padding-inline: 4px;
    }
  }
</style>
