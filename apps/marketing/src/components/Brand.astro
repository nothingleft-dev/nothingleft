---
import {
  MARK_BARS,
  MARK_LAST_BAR,
  MARK_VIEWBOX,
  WORDMARK_LETTERS,
  WORDMARK_RING,
  WORDMARK_UNDERLINE,
  WORDMARK_VIEWBOX,
} from '@lib/brand';

interface Props {
  size?: number;
  wordmark?: boolean;
}

const { size = 22, wordmark = false } = Astro.props;
---

<svg width={size} height={size} viewBox={MARK_VIEWBOX} aria-hidden="true" class="flex-none">
  {MARK_BARS.map(points => (
    <polygon points={points} fill="currentColor" />
  ))}
  <polygon points={MARK_LAST_BAR} fill="var(--accent)" />
</svg>
{wordmark && (
  <svg viewBox={WORDMARK_VIEWBOX} class="h-[20px] w-auto flex-none" aria-hidden="true">
    <path fill="currentColor" d={WORDMARK_LETTERS} />
    <circle
      fill="none"
      stroke="var(--accent)"
      cx={WORDMARK_RING.cx}
      cy={WORDMARK_RING.cy}
      r={WORDMARK_RING.r}
      stroke-width={WORDMARK_RING.strokeWidth}
    />
    <rect
      fill="var(--accent)"
      x={WORDMARK_UNDERLINE.x}
      y={WORDMARK_UNDERLINE.y}
      width={WORDMARK_UNDERLINE.width}
      height={WORDMARK_UNDERLINE.height}
      rx={WORDMARK_UNDERLINE.rx}
    />
  </svg>
)}
