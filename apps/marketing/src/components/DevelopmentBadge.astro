---
import type { BadgeTone } from '@lib/features/git-integration';

interface Props {
  badge: { label: string; tone: BadgeTone };
}

const { badge } = Astro.props;
---

<span class:list={['dev-badge', `dev-${badge.tone}`]}>
  <i aria-hidden="true"></i>
  <span class="sr-only">Development: </span>
  {badge.label}
</span>

<style>
  .dev-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-width: 0;
    max-width: 100%;
    height: 18px;
    padding: 0 6px 0 5px;
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    font-size: 11px;
    line-height: 16px;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .dev-badge i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex: none;
    background: var(--dot);
  }
  .dev-green {
    --dot: var(--palette-green-solid);
  }
  .dev-red {
    --dot: var(--palette-red-solid);
    color: var(--palette-red-fg);
  }
  .dev-yellow {
    --dot: var(--palette-yellow-solid);
  }
  .dev-gray {
    --dot: var(--palette-gray-solid);
  }
  .dev-orange {
    --dot: var(--palette-orange-solid);
  }
</style>
