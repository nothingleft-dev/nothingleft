# Copy to apps/marketing/.env. Astro inlines PUBLIC_* into the static build; everything else
# stays server-side and never reaches the browser.

# Optional Google Analytics measurement ID.
# PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXX

# Optional Microsoft Clarity project ID.
# PUBLIC_CLARITY_PROJECT_ID=xxxxxxxxxx

# Turso database for support requests (worker/index.ts). Secrets: never prefix with PUBLIC_.
# `wrangler dev` reads them from this file; in production set them with `wrangler secret put`.
# TURSO_DATABASE_URL=libsql://<database>-<org>.turso.io
# TURSO_AUTH_TOKEN=
