// Static assets serve every page without running Worker code, so the free plan's 10ms CPU
// limit never applies to them. Only /api/* runs the Worker; it awaits Turso over the network,
// which is wall time, not CPU time.
{
  "name": "nothingleft-marketing",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
}
