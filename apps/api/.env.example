# Copy to apps/api/.env and fill in. Validated at boot by apps/api/src/config/env.ts;
# variable meanings are in docs/infrastructure.md#environment-configuration.
#
# Local development runs against Neon and Upstash directly. docker-compose.yml
# is the self-hosting / offline alternative, not the default. To run only the tests against
# it, see .env.test.example.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Logging - docs/backend-guide.md#logging
# LOG_TARGETS: comma list of pretty (coloured stdout) · json (stdout) · file (LOG_FILE, JSON)
# · posthog (warn and above to PostHog Logs; needs POSTHOG_KEY).
# Dev default pretty,file so an LLM can grep logs/api.log by request_id. Production: json,posthog.
LOG_LEVEL=debug
LOG_TARGETS=pretty,file
LOG_FILE=logs/api.log

# Neon issues two connection strings. They are NOT interchangeable.
# DATABASE_URL        = direct/unpooled  → migrations, pg-boss
# DATABASE_URL_POOLED = pooled (pgBouncer) → application queries
DATABASE_URL=postgres://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_URL_POOLED=postgres://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full

# Upstash Redis - MUST be rediss:// (TLS); plain redis:// is refused at boot except for localhost.
REDIS_URL=rediss://default:PASSWORD@xxx.upstash.io:6379

APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
# Where /mcp's tools reach the REST API. Unset: http://127.0.0.1:$PORT (this process).
# MCP_API_BASE_URL=

# Object storage - docs/file-storage.md#two-buckets. Unset, avatar and attachment routes
# answer storage.not_configured. Locally: `docker compose up -d storage` (RustFS), uncomment
# these, then once `bun run storage:init` to create both buckets.
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=auto
# S3_ACCESS_KEY_ID=nothingleft
# S3_SECRET_ACCESS_KEY=nothingleft-secret
# S3_PUBLIC_BUCKET=nl-public
# S3_PUBLIC_BUCKET_BASE_URL=http://localhost:9000/nl-public
# S3_PRIVATE_BUCKET=nl-private
# Leave both keys unset to sign with the runtime's role (an ECS task role); set both or neither.
# Where browsers reach the store, when the API reaches it at another address (Docker Compose).
# S3_BROWSER_ENDPOINT=
# The files route mounts at this URL's path; unset, it is API_BASE_URL/files.
# FILES_BASE_URL=http://localhost:4000/files
# Lets a bring-your-own storage connection name its own endpoint (a second bucket on the local
# store); never in production, which builds it from the R2 account ID or the S3 region.
# BYO_ALLOW_ANY_ENDPOINT=true

# Transactional email - docs/notifications.md#transactional-email. EMAIL_PROVIDER is resend
# (default), zoho or smtp. The chosen provider's credentials are required in production. Unset,
# the message is logged instead of sent, with its body only under NODE_ENV=development, so the
# verification link is still copy-pasteable locally.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
# ZOHO_EMAIL_API_KEY=
# ZOHO_EMAIL_ENDPOINT=https://cpaas.zoho.com/v1.1/email
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# Where email logos load from (`email/logo-light.png`, `email/logo-dark.png`).
# ASSET_BASE_URL=https://static.nothingleft.dev
EMAIL_FROM="Nothing Left <noreply@localhost>"
# Where replies to every email go (Reply-To); emails that ask people to write in say "reply to this email".
# SUPPORT_EMAIL=help@example.com
# Signs unsubscribe links (32+ characters). Required in production; unset locally uses a development value.
# EMAIL_LINK_SECRET=
# 32 bytes, base64 (`openssl rand -base64 32`): seals two-factor and BYO storage secrets. Required in production;
# unset locally uses a development key. Changing it makes every sealed secret unreadable.
# ENCRYPTION_MASTER_KEY=

# OAuth - docs/auth-and-tenancy.md#flows. Register the redirect URI
# APP_BASE_URL/auth/google/callback and APP_BASE_URL/auth/github/callback with each provider.
# Unset, that provider's button answers auth.oauth_not_configured.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Set on production so the cookie covers app. and api. - docs/auth-and-tenancy.md#the-cookie.
# SESSION_COOKIE_DOMAIN=.nothingleft.dev

# Proxy hops in front of the API (one on Fly, AWS ALB / CloudFront, OCI LB), or the proxies' IPs / CIDRs.
# Unset: 1 in production, false elsewhere - docs/infrastructure.md#proxy-trust.
# TRUST_PROXY=1

# Plan limits for self-hosters; they override the `free` preset only.
# FREE_SEAT_LIMIT=20
# FREE_STORAGE_BYTES=5368709120

# PostHog - docs/analytics.md#kill-switches. Both switches independent; no-op when off or key empty.
POSTHOG_KEY=phc_xxx
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_ANALYTICS_ENABLED=false
POSTHOG_ERRORS_ENABLED=false
POSTHOG_SAMPLE_RATE=1.0
POSTHOG_REPLAY_ENABLED=false
