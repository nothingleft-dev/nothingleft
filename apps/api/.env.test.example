# Copy to apps/api/.env.test to run the test suite against local containers instead of Neon.
# `bun test` loads it over apps/api/.env; anything not set here still comes from .env.
# Start them with `docker compose up -d postgres redis storage`, migrate once with
# `cd packages/db && bun run db:migrate:test`. Delete this file to test against Neon again.

DATABASE_URL=postgres://nothingleft:nothingleft@localhost:5432/nothingleft
DATABASE_URL_POOLED=postgres://nothingleft:nothingleft@localhost:5432/nothingleft
REDIS_URL=redis://localhost:6379
POSTHOG_ANALYTICS_ENABLED=false
POSTHOG_ERRORS_ENABLED=false

# The S3 stand-in, for test/attachments.s3.test.ts (skipped without it):
# `docker compose up -d storage`, then once `NODE_ENV=test bun run storage:init`.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=nothingleft
S3_SECRET_ACCESS_KEY=nothingleft-secret
S3_PRIVATE_BUCKET=nl-private
S3_PUBLIC_BUCKET=nl-public
S3_PUBLIC_BUCKET_BASE_URL=http://localhost:9000/nl-public
# test/storage.s3.test.ts creates a second bucket, nl-byo-test, on the same store as the customer's.
FILES_BASE_URL=http://localhost:4000/files
