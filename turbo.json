{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["apps/api/.env*", "apps/web/.env*"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_API_BASE_URL", "NEXT_PUBLIC_GA_MEASUREMENT_ID"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "DATABASE_URL_POOLED", "REDIS_URL"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.mjs"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
